<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gil</RootNamespace>
    <Description>A habit runtime for LLM decisions: answers repeated requests from memory or from a small tree of one-token judgments, and generates only what the tree cannot settle, narrowed to the category it confirmed.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gil.Abstractions\Gil.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="IronHive.Providers.OpenAI.Compatible" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gil.Tests" />
  </ItemGroup>
</Project>
