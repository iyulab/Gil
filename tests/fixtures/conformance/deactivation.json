{"task":"conformance-resolver","tree":"id: root\nchildren:\n- id: billing\n  description: charges, refunds, invoices and ways to pay\n  options:\n  - id: refund-status\n    label: refund status\n    description: asks where a refund is or when it arrives\n    text: Refunds reach the original payment method within 5 business days of approval.\n  - id: invoice-copy\n    kind: template\n    label: invoice copy\n    description: asks for a copy of the invoice for an order\n    template: The invoice for order {order} has been sent to {inbox}.\n    slots:\n    - name: order\n      instruction: the order number in the request, or \"unknown\"\n    - name: inbox\n      instruction: fixed\n      fixed: the email address on the account\n  - id: payment-methods\n    label: payment methods\n    description: asks which cards or wallets are accepted\n    text: We accept major credit cards, debit cards and bank transfer.\n- id: shipping\n  description: where a parcel is, how long delivery takes and what it costs\n  options:\n  - id: track-order\n    kind: template\n    label: track order\n    description: asks where an order is now\n    template: Order {order} is on its way; the tracking link is in your confirmation email.\n    slots:\n    - name: order\n      instruction: the order number in the request, or \"unknown\"\n  - id: shipping-cost\n    label: shipping cost\n    description: asks what shipping costs\n    text: Shipping is free above 50 and 5 below that.\n  - id: promoted-143c963ac7\n    label: 'Standard delivery takes 3 to 5 business '\n    description: shipping delivery time to my town?\n    text: Standard delivery takes 3 to 5 business days.\n    origin: promoted\n- id: account\n  description: signing in, security and profile details\n  children:\n  - id: security\n    description: passwords and sign-in protection\n    options:\n    - id: reset-password\n      label: reset password\n      description: cannot sign in or wants a new password\n      text: Use \"Forgot password\" on the sign-in page; the link is valid for one hour.\n    - id: two-factor\n      label: two factor\n      description: asks how to turn on a second sign-in step\n      text: Turn on two-step sign-in under Settings, then Security.\n  - id: profile\n    description: the details stored on the account\n    options:\n    - id: change-email\n      kind: procedure\n      label: change email\n      description: wants the account email changed\n      steps: Confirm the current address, send a code to the new one, and switch only after the code is entered.\n    - id: promoted-2ec77ac3e1\n      label: 'Accounts are closed from Settings, then '\n      description: account profile how do i close account\n      text: Accounts are closed from Settings, then Privacy; data is removed after 30 days.\n      origin: promoted\n- id: returns\n  description: sending an item back\n  options:\n  - id: return-policy\n    label: return policy\n    description: asks whether and until when an item can be returned\n    text: Items can be returned within 30 days in their original condition.\n  - id: return-label\n    kind: template\n    label: return label\n    description: asks for a label to send an item back\n    template: A return label for order {order} is attached; drop the parcel at any post office.\n    slots:\n    - name: order\n      instruction: the order number in the request, or \"unknown\"\n- id: warranty\n  description: repairs and replacements under warranty\n","weights":{"reinforce":1.0,"penalty":3.0,"prior_strength":2.0},"requests":[{"mode":"partial","last":{"node":"shipping","outcome":"exit","chosen":null}},{"mode":"partial","last":{"node":"account","outcome":"exit","chosen":null}},{"mode":"fallback","last":{"node":"root","outcome":"exit","chosen":null}},{"mode":"fallback","last":{"node":"root","outcome":"exit","chosen":null}},{"mode":"fallback","last":{"node":"root","outcome":"exit","chosen":null}},{"mode":"fallback","last":{"node":"root","outcome":"exit","chosen":null